{
  "name_rules": [
    "accent_strip",
    "lowercase",
    "whitespace_collapse",
    "suffix_canonicalize",
    "domain_strip",
    "punct_strip",
    "whitespace_final"
  ],
  "addr_rules": [
    "abbrev_expand",
    "punct_strip",
    "token_sort"
  ],
  "criteria": {
    "accent": "affected tfidf delta>=0.01 and overall gap delta>=-0.002",
    "addr": "greedy, gain in (gap_edit+gap_jaccard) >= 0.003"
  }
}